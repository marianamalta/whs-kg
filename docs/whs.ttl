    dcterms:source <https://whc.unesco.org/en/list/1279> ;
    dcterms:title "جبل ووتاي"@ar,
        "Mount Wutai"@en,
        "Monte Wutai"@es,
        "Mont Wutai"@fr,
        "五台山"@zh ;
