PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX whs:     <https://w3id.org/whs/terms/>
PREFIX crm:     <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX schema:  <http://schema.org/>
PREFIX wdt:     <http://www.wikidata.org/prop/direct/>
PREFIX wd:      <http://www.wikidata.org/entity/>
PREFIX geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>

# CQ4 (UC2): How are the inscription criteria distributed by World Heritage region?
SELECT ?region ?criterion (COUNT(DISTINCT ?site) AS ?n) WHERE {
  ?site whs:region ?region ; wdt:P2614 ?criterion .
} GROUP BY ?region ?criterion ORDER BY ?region ?criterion