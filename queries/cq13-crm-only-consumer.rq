PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX whs:     <https://w3id.org/whs/terms/>
PREFIX crm:     <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX schema:  <http://schema.org/>
PREFIX wdt:     <http://www.wikidata.org/prop/direct/>
PREFIX wd:      <http://www.wikidata.org/entity/>
PREFIX geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>

# Interoperability check (R3): a consumer that knows only CIDOC CRM.
# Against graph <https://w3id.org/whs/graph/crm>: danger periods as E52 time-spans.
SELECT ?site ?begin ?end WHERE {
  ?site crm:P12i_was_present_at ?ev .
  ?ev crm:P9_consists_of/crm:P4_has_time-span ?ts .
  ?ts crm:P82a_begin_of_the_begin ?begin .
  OPTIONAL { ?ts crm:P82b_end_of_the_end ?end }
} ORDER BY ?begin LIMIT 20