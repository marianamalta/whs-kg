PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX whs:     <https://w3id.org/whs/terms/>
PREFIX crm:     <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX schema:  <http://schema.org/>
PREFIX wdt:     <http://www.wikidata.org/prop/direct/>
PREFIX wd:      <http://www.wikidata.org/entity/>
PREFIX geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>

# CQ2 (UC1): How many listing periods started in each decade, by danger type?
SELECT ?decade ?type (COUNT(*) AS ?n) WHERE {
  ?site crm:P12i_was_present_at ?ev .
  ?ev dcterms:temporal ?iv ; dcterms:subject ?type .
  BIND (CONCAT(SUBSTR(STR(?iv), 1, 3), "0s") AS ?decade)
} GROUP BY ?decade ?type ORDER BY ?decade ?type